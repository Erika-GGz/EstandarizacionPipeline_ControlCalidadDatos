{
  "contract_name": "iris_model_input_contract",
  "version": "1.0.0",
  "description": "Contrato de datos oficial para la inferencia del modelo RandomForest entrenado con el dataset Iris.",
  "input": {
    "format": "objeto JSON con exactamente 4 campos numéricos, todos obligatorios",
    "fields": {
      "sepal length (cm)": {
        "type": "float",
        "nullable": false,
        "min": 3.0,
        "max": 9.0,
        "description": "Longitud del sépalo en centímetros"
      },
      "sepal width (cm)": {
        "type": "float",
        "nullable": false,
        "min": 1.0,
        "max": 6.0,
        "description": "Ancho del sépalo en centímetros"
      },
      "petal length (cm)": {
        "type": "float",
        "nullable": false,
        "min": 0.5,
        "max": 8.0,
        "description": "Longitud del pétalo en centímetros"
      },
      "petal width (cm)": {
        "type": "float",
        "nullable": false,
        "min": 0.1,
        "max": 3.5,
        "description": "Ancho del pétalo en centímetros"
      }
    }
  },
  "output": {
    "field": "species",
    "type": "int",
    "allowed_values": {
      "0": "setosa",
      "1": "versicolor",
      "2": "virginica"
    }
  },
  "examples": {
    "valid_input": {
      "sepal length (cm)": 5.1,
      "sepal width (cm)": 3.5,
      "petal length (cm)": 1.4,
      "petal width (cm)": 0.2
    },
    "invalid_input": {
      "input": {
        "sepal length (cm)": 50.0,
        "sepal width (cm)": null,
        "petal length (cm)": 1.4,
        "petal width (cm)": "ancho"
      },
      "reasons": [
        "sepal length (cm) = 50.0 está fuera del rango [3.0, 9.0]",
        "sepal width (cm) es nulo y el campo es obligatorio",
        "petal width (cm) debe ser float, se recibió texto"
      ]
    }
  }
}